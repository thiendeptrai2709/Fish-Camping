  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Game Text_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: f1a165d24478b5741b965a38ede7488c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 20646425034416128
    m_Localized: Hello, young man; I am going to assign you a task.
    m_Metadata:
      m_Items: []
  - m_Id: 20645879879753728
    m_Localized: Quest NPC
    m_Metadata:
      m_Items: []
  - m_Id: 20646556181913600
    m_Localized: Then come back here to claim your reward.
    m_Metadata:
      m_Items: []
  - m_Id: 20646706207973376
    m_Localized: Press V to view missions.
    m_Metadata:
      m_Items: []
  - m_Id: 20646995824664576
    m_Localized: Hi there! How did the fishing go today?
    m_Metadata:
      m_Items: []
  - m_Id: 20647203899891712
    m_Localized: The weather around the lake is truly beautiful today!
    m_Metadata:
      m_Items: []
  - m_Id: 20647805719601152
    m_Localized: Do you need any more help, my friend?
    m_Metadata:
      m_Items: []
  - m_Id: 20647965673578496
    m_Localized: Continue with the mission.
    m_Metadata:
      m_Items: []
  - m_Id: 20648069956558848
    m_Localized: This fish is amazing.
    m_Metadata:
      m_Items: []
  - m_Id: 20648337284718592
    m_Localized: I am going to assign you a task; are you ready?
    m_Metadata:
      m_Items: []
  - m_Id: 20648415256829952
    m_Localized: Carry on with the mission.
    m_Metadata:
      m_Items: []
  - m_Id: 20648528440123392
    m_Localized: You're really good.
    m_Metadata:
      m_Items: []
  - m_Id: 20648653614931968
    m_Localized: Thanks a lot! Thanks to you, everything went smoothly.
    m_Metadata:
      m_Items: []
  - m_Id: 20648726562267136
    m_Localized: "The weather is really nice today\u2014take a break!"
    m_Metadata:
      m_Items: []
  - m_Id: 20656073783304192
    m_Localized: The Mechanic
    m_Metadata:
      m_Items: []
  - m_Id: 20656537341976576
    m_Localized: Hi there! This truck looks really rusty, doesn't it?
    m_Metadata:
      m_Items: []
  - m_Id: 20656611547602944
    m_Localized: If you want to head into the Misty Swamp area, standard tires will
      likely slip.
    m_Metadata:
      m_Items: []
  - m_Id: 20656681022054400
    m_Localized: Let me see if I can upgrade you to a set of off-road tires!
    m_Metadata:
      m_Items: []
  - m_Id: 20656765742800896
    m_Localized: Looking to add any more mods to your car?
    m_Metadata:
      m_Items: []
  - m_Id: 20660019486711808
    m_Localized: Salesman
    m_Metadata:
      m_Items: []
  - m_Id: 20660121836118016
    m_Localized: Hey there, young friend! Need some killer bait or top-notch gear
      for your fishing trip?
    m_Metadata:
      m_Items: []
  - m_Id: 20660222079983616
    m_Localized: "Or if you catch any fresh, delicious fish, just bring them all
      here and I\u2019ll buy them from you at a good price!"
    m_Metadata:
      m_Items: []
  - m_Id: 20660339122036736
    m_Localized: Stopping by the fishing shop again, young man?
    m_Metadata:
      m_Items: []
  - m_Id: 20660400321126400
    m_Localized: Any fresh catch today?
    m_Metadata:
      m_Items: []
  - m_Id: 20660979663560704
    m_Localized: SETTING
    m_Metadata:
      m_Items: []
  - m_Id: 20661061809004544
    m_Localized: SOUND
    m_Metadata:
      m_Items: []
  - m_Id: 20661192734203904
    m_Localized: EFFECT
    m_Metadata:
      m_Items: []
  - m_Id: 20661362926477312
    m_Localized: LOG OUT
    m_Metadata:
      m_Items: []
  - m_Id: 20661473421221888
    m_Localized: EXIT GAME
    m_Metadata:
      m_Items: []
  - m_Id: 20661599820767232
    m_Localized: SCREEN
    m_Metadata:
      m_Items: []
  - m_Id: 20661672877154304
    m_Localized: LANGUAGE
    m_Metadata:
      m_Items: []
  - m_Id: 20668835653672960
    m_Localized: Move character
    m_Metadata:
      m_Items: []
  - m_Id: 20668960526491648
    m_Localized: Interact with NPC, exit vehicle
    m_Metadata:
      m_Items: []
  - m_Id: 20669154622103552
    m_Localized: Backpack
    m_Metadata:
      m_Items: []
  - m_Id: 20669283060080640
    m_Localized: Closing the garage shop
    m_Metadata:
      m_Items: []
  - m_Id: 20669438257717248
    m_Localized: Select a map to play
    m_Metadata:
      m_Items: []
  - m_Id: 20669527155990528
    m_Localized: Make the character run fast.
    m_Metadata:
      m_Items: []
  - m_Id: 20669637210333184
    m_Localized: Decorate
    m_Metadata:
      m_Items: []
  - m_Id: 20669716436541440
    m_Localized: Setting
    m_Metadata:
      m_Items: []
  - m_Id: 20671095188152320
    m_Localized: Villagers
    m_Metadata:
      m_Items: []
  - m_Id: 20671173885878272
    m_Localized: "Hi there, the weather is quite nice today\u2014would you like to
      go out somewhere?"
    m_Metadata:
      m_Items: []
  - m_Id: 20671253959335936
    m_Localized: I think we'll meet again next time.
    m_Metadata:
      m_Items: []
  - m_Id: 20672994616467456
    m_Localized: "Are you new to this town? It\u2019s peaceful here, and the people
      are very kind."
    m_Metadata:
      m_Items: []
  - m_Id: 20673163135213568
    m_Localized: Did you just come here to fill up?
    m_Metadata:
      m_Items: []
  - m_Id: 20673312829923328
    m_Localized: Gasoline in this town is really cheap, so feel free to fill up as
      much as you want.
    m_Metadata:
      m_Items: []
  - m_Id: 20673419402993664
    m_Localized: "I'm a beautiful girl\u2014did you know that?"
    m_Metadata:
      m_Items: []
  - m_Id: 20673630233878528
    m_Localized: Is your bike out of gas again?
    m_Metadata:
      m_Items: []
  - m_Id: 20673742670585856
    m_Localized: Do you think I look prettier?
    m_Metadata:
      m_Items: []
  - m_Id: 20673913437478912
    m_Localized: Wishing you a good morning.
    m_Metadata:
      m_Items: []
  - m_Id: 20674051920814080
    m_Localized: "I\u2019m 70 years old now, so I can\u2019t travel far anymore\u2014I
      just stay around this town."
    m_Metadata:
      m_Items: []
  - m_Id: 20674220166930432
    m_Localized: What have you caught so far, young man?
    m_Metadata:
      m_Items: []
  - m_Id: 20677417157713920
    m_Localized: QUEST
    m_Metadata:
      m_Items: []
  - m_Id: 21001049943760896
    m_Localized: RECEIVE
    m_Metadata:
      m_Items: []
  - m_Id: 21001898094944256
    m_Localized: 'Item 1: Spotted Orange Lake Fish'
    m_Metadata:
      m_Items: []
  - m_Id: 21002071130955776
    m_Localized: 'Question 1: Long-whiskered catfish'
    m_Metadata:
      m_Items: []
  - m_Id: 21008988964315136
    m_Localized: 'Refueling [F]'
    m_Metadata:
      m_Items: []
  - m_Id: 21009400131936256
    m_Localized: Press the [B] key to enter the Garage
    m_Metadata:
      m_Items: []
  - m_Id: 21010978775687168
    m_Localized: Equipment
    m_Metadata:
      m_Items: []
  - m_Id: 21011363292700672
    m_Localized: Fishing Rod
    m_Metadata:
      m_Items: []
  - m_Id: 21011594046529536
    m_Localized: Bait
    m_Metadata:
      m_Items: []
  - m_Id: 21011779342491648
    m_Localized: Lifebuoy
    m_Metadata:
      m_Items: []
  - m_Id: 21012247317766144
    m_Localized: Trunk
    m_Metadata:
      m_Items: []
  - m_Id: 21014235413667840
    m_Localized: Machine Repair
    m_Metadata:
      m_Items: []
  - m_Id: 21014397666123776
    m_Localized: Top up with water
    m_Metadata:
      m_Items: []
  - m_Id: 21015029726765056
    m_Localized: Move
    m_Metadata:
      m_Items: []
  - m_Id: 21015394492801024
    m_Localized: Diary
    m_Metadata:
      m_Items: []
  - m_Id: 21017909972099072
    m_Localized: Build
    m_Metadata:
      m_Items: []
  - m_Id: 21018370594758656
    m_Localized: Cook
    m_Metadata:
      m_Items: []
  - m_Id: 21022656837902336
    m_Localized: GARAGE
    m_Metadata:
      m_Items: []
  - m_Id: 21023071197388800
    m_Localized: '[F] Stocking Up on Gasoline'
    m_Metadata:
      m_Items: []
  - m_Id: 21023280585433088
    m_Localized: Purchased
    m_Metadata:
      m_Items: []
  - m_Id: 21023716780466176
    m_Localized: Refuel
    m_Metadata:
      m_Items: []
  - m_Id: 21023881075548160
    m_Localized: Close
    m_Metadata:
      m_Items: []
  - m_Id: 21027836161613824
    m_Localized: GUIDE
    m_Metadata:
      m_Items: []
  - m_Id: 21027836161613825
    m_Localized: Press [Ctrl] to start
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808128
    m_Localized: Press [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808129
    m_Localized: Press [Tab] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808130
    m_Localized: Press [N] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808131
    m_Localized: Press [E] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808132
    m_Localized: Press [Z] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808133
    m_Localized: Press [M] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808134
    m_Localized: Press [B] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808135
    m_Localized: Press [J] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808136
    m_Localized: Press [P] or [Ctrl] to complete | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808137
    m_Localized: Press [Space] or [Ctrl] to continue | [R] Back
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808138
    m_Localized: '[R] Back'
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808139
    m_Localized: Welcome to <color=#B388FF><b>Fish-Camping</b></color>!
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808140
    m_Localized: Use <color=#B388FF><b>W, A, S, D</b></color> to move and hold <color=#B388FF><b>Shift</b></color>
      to sprint.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808141
    m_Localized: Look around and locate your <color=#B388FF><b>Old Truck</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808142
    m_Localized: <color=#B388FF><b>Left Click</b></color> the trunk to inspect, press
      <color=#B388FF><b>Tab</b></color> to close.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808143
    m_Localized: Hover your <color=#B388FF><b>Cursor</b></color> over the vehicle
      to inspect, step back to exit.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808144
    m_Localized: Open the <color=#B388FF><b>Hood</b></color> to inspect engine, repair
      and refill coolant.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808145
    m_Localized: Press <color=#B388FF><b>N</b></color> to open the Map.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808146
    m_Localized: Click the <color=#B388FF><b>Tackle Shop Icon</b></color> on the
      map to set waypoint.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808147
    m_Localized: Approach vehicle door and <color=#B388FF><b>Left Click</b></color>
      to get in.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836165808148
    m_Localized: 'Drive to Shop (Press <color=#B388FF><b>E</b></color> to exit).
      (Radio: <color=#B388FF><b>L</b></color> Power | <color=#B388FF><b>K</b></color>
      Track | <color=#B388FF><b>[ ]</b></color> Vol | <color=#B388FF><b>G</b></color>
      Lights).'
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002432
    m_Localized: Approach <color=#B388FF><b>Shopkeeper</b></color> to buy gear, press
      <color=#B388FF><b>E</b></color> to close.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002433
    m_Localized: Press <color=#B388FF><b>N</b></color> to open map and locate the
      <color=#B388FF><b>Mechanic NPC</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002434
    m_Localized: Interact with <color=#B388FF><b>Mechanic</b></color> to upgrade
      your vehicle, press <color=#B388FF><b>Z</b></color> to exit.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002435
    m_Localized: Find the <color=#B388FF><b>Quest NPC</b></color> in town to receive
      your first quest.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002436
    m_Localized: Drive around town to find the <color=#B388FF><b>Gas Station</b></color>
      and refuel your vehicle.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002437
    m_Localized: Talk to the <color=#B388FF><b>Gas Attendant</b></color> to learn
      more details.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002438
    m_Localized: Exit the truck and walk to the fuel pump to buy a spare fuel can.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002439
    m_Localized: Open the <color=#B388FF><b>Trunk</b></color> to verify the fuel
      can is stored inside.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002440
    m_Localized: Press <color=#B388FF><b>M</b></color> to open the travel map and
      travel to <color=#B388FF><b>Pine Lake</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002441
    m_Localized: Press <color=#B388FF><b>N</b></color> to open the map and find the
      campsite.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002442
    m_Localized: Head over to the lakeside <color=#B388FF><b>Campsite</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002443
    m_Localized: Double check your <color=#B388FF><b>Fishing Gear</b></color> before
      casting.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002444
    m_Localized: Press <color=#B388FF><b>Tab</b></color> to open your Backpack.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002445
    m_Localized: Drag the <color=#B388FF><b>Rod, Bait, and Bobber</b></color> into
      your equipment slots.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002446
    m_Localized: Walk over to the <color=#B388FF><b>Lakeshore</b></color> to prepare
      for fishing.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002447
    m_Localized: You can fish along the shorelines of Pine Lake.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002448
    m_Localized: <color=#B388FF><b>Fishing:</b></color> <color=#B388FF><b>Left Click</b></color>
      to cast, hold/click <color=#B388FF><b>Left Click</b></color> to control tension.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002449
    m_Localized: <color=#B388FF><b>Left Click</b></color> to keep the fish or press
      <color=#B388FF><b>Space</b></color> to release it.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002450
    m_Localized: Press <color=#B388FF><b>Tab</b></color> to open your Backpack and
      inspect your catch.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002451
    m_Localized: Unequip your rod and head over to the <color=#B388FF><b>Campfire</b></color>
      area.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002452
    m_Localized: You can sell fish for gold or cook them for sustenance.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002453
    m_Localized: Press <color=#B388FF><b>B</b></color> to open camping menu, pick
      <color=#B388FF><b>Firewood</b></color> and place it.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002454
    m_Localized: Select the <color=#B388FF><b>Cooking Tripod</b></color> and snap
      it over the firewood.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002455
    m_Localized: <color=#B388FF><b>Cooking:</b></color> Drag a caught fish onto the
      campfire grill.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836170002456
    m_Localized: Pick up the grilled fish and eat it to restore your energy.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836174196736
    m_Localized: Enter your tent and sleep to fully recover your energy.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836174196737
    m_Localized: Press <color=#B388FF><b>B</b></color> to find the <color=#B388FF><b>Lantern</b></color>
      and place it (can be toggled on/off).
    m_Metadata:
      m_Items: []
  - m_Id: 21027836174196738
    m_Localized: After camping, get into your truck and drive back to <color=#B388FF><b>Town</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836174196739
    m_Localized: Press <color=#B388FF><b>J</b></color> to view your <color=#B388FF><b>Fish
      Journal</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21027836174196740
    m_Localized: Press <color=#B388FF><b>P</b></color> anytime to review <color=#B388FF><b>Controls
      and Help Guide</b></color>.
    m_Metadata:
      m_Items: []
  - m_Id: 21033738956627968
    m_Localized: '[Left Click] Enter vehicle'
    m_Metadata:
      m_Items: []
  - m_Id: 21033736372936704
    m_Localized: '[Left Click] Open trunk'
    m_Metadata:
      m_Items: []
  - m_Id: 21033739812265984
    m_Localized: '[Left Click] View vehicle stats'
    m_Metadata:
      m_Items: []
  - m_Id: 21033952706748416
    m_Localized: '[Left Click] Check tires'
    m_Metadata:
      m_Items: []
  - m_Id: 21033955172999168
    m_Localized: '[Left Click] Open hood'
    m_Metadata:
      m_Items: []
  references:
    version: 2
