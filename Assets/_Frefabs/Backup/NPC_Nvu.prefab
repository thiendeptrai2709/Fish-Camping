--- !u!114 &8898449558618441033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6864851731744354889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f24bd847d964f9a45a47531f9c6db5c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCBase
  npcName: "D\xE2n L\xE0ng"
  promptMessage: "N\xF3i chuy\u1EC7n"
  introDialogues:
  - "Ch\xE0o c\u1EADu, h\xF4m nay th\u1EDDi ti\u1EBFt \u1EDF H\u1ED3 Th\xF4ng th\u1EADt
    \u0111\u1EB9p!"
  - "C\u1EADu c\xF3 c\xE2u \u0111\u01B0\u1EE3c con c\xE1 V\u01B0\u1EE3c n\xE0o l\u1EDBn
    kh\xF4ng?"
  _questGiver: {fileID: 7158468785501937978}
  _tireUpgrader: {fileID: 0}
  _fishingShop: {fileID: 0}
--- !u!114 &7158468785501937978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6864851731744354889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2286b62a70f70974d9132fc2d0e8a1e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestGiver
  questName: "S\u0103n T\xECm C\xE1 V\u01B0\u1EE3c H\u1ED3 Th\xF4ng"
  targetItem: Largemouth Bass
  rewardGold: 150
  offerDialogues:
  - "Ch\xE0o c\u1EADu l\u1EEF kh\xE1ch! Ta nghe n\xF3i \xF4ng c\u1EE7a c\u1EADu \u0111\u1EC3
    l\u1EA1i m\u1ED9t cu\u1ED1n nh\u1EADt k\xFD c\xE1 r\u1EA5t gi\xE1 tr\u1ECB."
  - "Ta \u0111ang r\u1EA5t th\xE8m m\u1ED9t b\u1EEFa c\xE1 V\u01B0\u1EE3c n\u01B0\u1EDBng
    b\xEAn H\u1ED3 Th\xF4ng, c\u1EADu c\xF3 th\u1EC3 gi\xFAp ta c\xE2u m\u1ED9t con
    [Largemouth Bass] kh\xF4ng?"
  - "Ta s\u1EBD th\u01B0\u1EDFng cho c\u1EADu 150G \u0111\u1EC3 n\xE2ng c\u1EA5p
    chi\u1EBFc xe t\u1EA3i c\u0169 \u0111\xF3!"
  progressDialogues:
  - "C\u1EADu v\u1EABn ch\u01B0a c\xE2u \u0111\u01B0\u1EE3c [Largemouth Bass] sao?"
  - "H\xE3y ki\u1EC3m tra l\u1EA1i m\u1ED3i b\u1ED9t ho\u1EB7c th\u1EED c\xE2u v\xE0o
    l\xFAc B\xECnh minh/Ho\xE0ng h\xF4n xem nh\xE9!"
  completeDialogues:
  - "\xD4i! Con c\xE1 V\u01B0\u1EE3c n\xE0y t\u01B0\u01A1i ngon qu\xE1! \u0110\xFAng
    l\xE0 tay ngh\u1EC1 d\xF2ng h\u1ECD c\u1EADu."
  - "C\u1EA7m l\u1EA5y 150G n\xE0y nh\u01B0 \u0111\xE3 h\u1EE9a. H\xE3y ti\u1EBFp
    t\u1EE5c h\xE0nh tr\xECnh \u0111i\u1EC1n k\xEDn cu\u1ED1n nh\u1EADt k\xFD nh\xE9!"
  finalDialogues:
  - "C\u1EA3m \u01A1n c\u1EADu v\xEC con c\xE1 nh\xE9! Ch\xFAc c\u1EADu m\u1ED9t
    ng\xE0y \u0111i c\xE2u vui v\u1EBB."
